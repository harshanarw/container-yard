# Copy to .env.testing for running the regression suite locally.
# Laravel loads .env.testing automatically when APP_ENV=testing (phpunit).
# Only the DB connection details are needed here — phpunit.xml sets the rest.

APP_ENV=testing
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=container_yard_testing
DB_USERNAME=root
DB_PASSWORD=

# Keep side effects out of tests
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
CACHE_STORE=array
